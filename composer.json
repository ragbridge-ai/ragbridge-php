{
    "name": "ragbridge/php",
    "description": "PHP client for the ragbridge retrieval-augmented generation service",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Ragbridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ragbridge\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.30",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^3.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "symfony/config": "^6.4||^7.0||^8.0",
        "symfony/dependency-injection": "^6.4||^7.0||^8.0",
        "symfony/http-client": "^6.4||^7.0||^8.0",
        "symfony/http-kernel": "^6.4||^7.0||^8.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel integration (^12.0 or ^13.0)",
        "symfony/framework-bundle": "Required to use the Symfony integration (^6.4, ^7.0 or ^8.0)",
        "symfony/http-client": "Lets the Symfony integration send requests through the application's HTTP client (^6.4, ^7.0 or ^8.0)"
    },
    "scripts": {
        "stan": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ],
        "test": "pest",
        "test:laravel": "pest --testsuite=Unit,Laravel",
        "test:symfony": "pest --testsuite=Unit,Symfony"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ragbridge\\Laravel\\RagbridgeServiceProvider"
            ],
            "aliases": {
                "Ragbridge": "Ragbridge\\Laravel\\Facades\\Ragbridge"
            }
        }
    }
}
